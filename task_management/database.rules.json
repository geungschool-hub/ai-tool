{
  "rules": {
    ".read": false,
    ".write": false,
    "tm": {
      ".read": "auth != null && (auth.uid === 'xmj4YNqWfLfLXTQJRDUjbmYKG6l1' || auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2')",
      "meta": {
        ".write": "auth != null && auth.uid === 'xmj4YNqWfLfLXTQJRDUjbmYKG6l1'",
        "lastReview": { ".write": "auth != null && auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2'" },
        "reviewReq":  { ".write": "auth != null && (auth.uid === 'xmj4YNqWfLfLXTQJRDUjbmYKG6l1' || (auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2' && newData.val() === false))" }
      },
      "boards": {
        ".write": "auth != null && auth.uid === 'xmj4YNqWfLfLXTQJRDUjbmYKG6l1'",
        "$bid": {
          ".validate": "newData.hasChildren(['name','areas'])",
          "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "icon":     { ".validate": "newData.isString() && newData.val().length <= 8" },
          "order":    { ".validate": "newData.isNumber()" },
          "lastArea": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "areas": {
            "$aid": {
              ".validate": "newData.hasChildren(['name'])",
              "name":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
              "color": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "order": { ".validate": "newData.isNumber()" }
            }
          }
        }
      },
      "tasks": {
        "$id": {
          ".write": "auth != null && (auth.uid === 'xmj4YNqWfLfLXTQJRDUjbmYKG6l1' || (auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2' && !data.exists() && newData.child('createdBy').val() === 'claude' && newData.child('ok').val() === false && newData.child('status').val() === 'todo'))",
          ".validate": "newData.hasChildren(['title','status','area','priority','createdBy','createdAt'])",
          "title":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "status":    { ".write": "auth != null && auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2' && data.exists() && newData.val() === 'done'",
                         ".validate": "newData.val() === 'todo' || newData.val() === 'doing' || newData.val() === 'done'" },
          "doneAt":    { ".write": "auth != null && auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2' && data.parent().child('status').exists()" },
          "updatedAt": { ".write": "auth != null && auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2' && data.parent().child('status').exists()" },
          "area":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "board":     { ".validate": "root.child('tm/boards').child(newData.val()).exists()" },
          "priority":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "due":       { ".validate": "newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "createdBy": { ".validate": "newData.val() === 'me' || newData.val() === 'notion' || newData.val() === 'claude'" },
          "claude":    { ".write": "auth != null && auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2'" },
          "checks": {
            "$cid": {
              ".write": "auth != null && auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2' && newData.child('by').val() === 'claude' && (!data.exists() || newData.child('text').val() === data.child('text').val())"
            }
          }
        }
      },
      "log": {
        "$id": { ".write": "auth != null && (auth.uid === 'xmj4YNqWfLfLXTQJRDUjbmYKG6l1' || (auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2' && !data.exists() && newData.child('by').val() === 'claude' && newData.child('via').val() === 'bot'))" }
      },
      "reviews": {
        "$id": { ".write": "auth != null && (auth.uid === 'xmj4YNqWfLfLXTQJRDUjbmYKG6l1' || (auth.uid === 'ts8VlEyKrtM4kA939VmdKkClUzl2' && !data.exists()))" }
      }
    }
  }
}
